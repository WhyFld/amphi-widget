{
  "rewrites": [
    { "source": "/widget", "destination": "/widget.html" }
  ],
  "headers": [
    {
      "source": "/widget.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/embed.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
